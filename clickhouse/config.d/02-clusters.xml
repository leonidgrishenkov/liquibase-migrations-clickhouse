<clickhouse>
    <!-- Two *logical* clusters on one physical node. That is the point: "cluster" here
         means a ClickHouse cluster name you can write `ON CLUSTER <name>` against, not a
         separate machine. It is what makes the per-cluster migration folders meaningful. -->
    <remote_servers replace="true">
        <analytics_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                    <user>liquibase</user>
                    <password>liquibase</password>
                </replica>
            </shard>
        </analytics_cluster>

        <staging_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                    <user>liquibase</user>
                    <password>liquibase</password>
                </replica>
            </shard>
        </staging_cluster>
    </remote_servers>

    <!-- Substituted into ReplicatedMergeTree ZooKeeper paths.
         Two sets, because there are two ways to replicate a table:

         sharded   - each shard owns its own ZK path, so every shard holds a different
                     slice of the data. {replica} need only be unique within its shard.
         broadcast - every shard shares ONE ZK path, so the whole cluster holds the same
                     copy of the table. That makes {replica_broadcast} have to be unique
                     across the entire cluster, not just within a shard.

         On this single node the two are indistinguishable in effect; they differ in the
         ZK path they produce, which is what matters on a real cluster. -->
    <macros>
        <shard>01</shard>
        <replica>replica-1</replica>
        <shard_broadcast>broadcast</shard_broadcast>
        <replica_broadcast>clickhouse-01</replica_broadcast>
    </macros>
</clickhouse>
