<clickhouse>
    <macros>
        <!-- {replica} only has to be unique within its shard. -->
        <shard>01</shard>
        <replica>s1r2</replica>
        <!-- Broadcast tables put every shard on ONE ZooKeeper path, so this replica
             name has to be unique across the whole cluster. -->
        <shard_broadcast>broadcast</shard_broadcast>
        <replica_broadcast>s1r2</replica_broadcast>
    </macros>
</clickhouse>
